<?xml version="1.0" encoding="UTF-8"?>
<banco>
  <curso nombre="5º Primaria">
    <asignatura nombre="Lengua">
      <tema nombre="Tema 1: Clases de palabras">
        <pregunta id="ej-le-01">
          <enunciado>¿Qué tipo de palabra es «rápidamente»?</enunciado>
          <opcion correcta="si">Adverbio</opcion>
          <opcion>Adjetivo</opcion>
          <opcion>Verbo</opcion>
          <opcion>Sustantivo</opcion>
          <explicacion>Indica cómo se hace algo. Muchos adverbios de modo terminan en -mente.</explicacion>
        </pregunta>
        <pregunta id="ej-le-02">
          <enunciado>En «El perro marrón ladra», ¿cuál es el adjetivo?</enunciado>
          <opcion correcta="si">marrón</opcion>
          <opcion>perro</opcion>
          <opcion>ladra</opcion>
          <opcion>El</opcion>
          <explicacion>«Marrón» dice cómo es el perro: es un adjetivo.</explicacion>
        </pregunta>
        <pregunta id="ej-le-03" respuesta="verdadero">
          <enunciado>«Correr» es un verbo.</enunciado>
          <explicacion>Expresa una acción y está en infinitivo (termina en -er).</explicacion>
        </pregunta>
      </tema>
    </asignatura>
  </curso>
